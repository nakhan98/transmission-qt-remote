FROM python:3.12-slim

# Set up working directory
WORKDIR /app

# Install minimal dependencies for unit tests (excluding Qt)
COPY requirements.unit.txt .
RUN pip install --no-cache-dir -r requirements.unit.txt

# Copy source code and test configuration
COPY pytest.ini .
COPY src/ src/
COPY tests/ tests/

# Set Python path for imports
ENV PYTHONPATH=/app/src

# Clear caches and run unit tests by default
RUN find . -name "*.pyc" -delete && find . -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true
CMD ["python", "-m", "pytest", "tests/unit/", "--cache-clear", "-v"]